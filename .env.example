# ============================================================
# LLM Injection Scanner — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Then load it when running Podman:
#   podman run --env-file .env llm-scanner scan ...
#
# NEVER commit your .env file to Git — it's already in .gitignore
# ============================================================

# --- OpenAI ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# --- Anthropic (Claude) ---
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- Generic / OpenAI-compatible providers ---
# Examples: Groq, Together AI, Mistral AI, LM Studio
GENERIC_API_KEY=your-key-here
GENERIC_BASE_URL=https://api.groq.com/openai/v1
GENERIC_MODEL=llama3-8b-8192
